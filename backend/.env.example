# Copiar como .env y completar tres contraseñas distintas solo en el equipo.
ACIS_POSTGRES_PASSWORD=
ACIS_USUARIOS_DB_PASSWORD=
ACIS_OPERACIONES_DB_PASSWORD=

# Opcional: crear el primer administrador al arrancar usuarios-service.
# Completar correo y clave juntos. No reutilizar la clave de firma del APK.
ACIS_ADMIN_NOMBRE=Administrador
ACIS_ADMIN_CORREO=
ACIS_ADMIN_CLAVE=

# Correo de desarrollo, recibido en Mailpit (http://localhost:8025).
ACIS_SMTP_HOST=localhost
ACIS_SMTP_PORT=1025
ACIS_CORREO_REMITENTE=acis@localhost.test
